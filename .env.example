# GA4 Measurement Protocol credentials — TEMPLATE. Copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is gitignored; this file is not. Never put a real api_secret here.
#
# Where the values come from: analytics.google.com -> Admin -> Data Streams ->
# (your web stream) -> Measurement Protocol API secrets. The measurement_id is
# on the stream detail page itself. Full setup order, including the four
# privacy settings that must be applied BEFORE the first hit, is in
# docs/analytics-setup.md.
#
# GA4 account for this project: aliaksandr.reserved@gmail.com
#
# Two properties, because dev traffic in the prod funnel makes every number
# unreliable and there is no way to separate it after the fact:
#
#   Lingogram dev   -> used by EXT_ENV=dev builds, posts to /debug/mp/collect
#   Lingogram prod  -> used by release builds,     posts to /mp/collect
#
# The debug endpoint returns validationMessages; prod answers 204 even for a
# malformed payload. That difference is why the dev property exists at all —
# it is the only way a bad event announces itself instead of silently vanishing
# from every report.

# --- dev property -----------------------------------------------------------
EXT_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
EXT_GA4_API_SECRET=

# --- prod property ----------------------------------------------------------
# Kept under separate names so a prod build can never accidentally inherit the
# dev secret from a stale shell. Release builds export these into the two
# variables above; see docs/analytics-setup.md.
EXT_GA4_MEASUREMENT_ID_PROD=G-XXXXXXXXXX
EXT_GA4_API_SECRET_PROD=

# Endpoint override. Only useful for pointing tests at a local stub — leave
# unset for real builds.
# EXT_GA4_ENDPOINT=https://www.google-analytics.com

# --- site (lingogram.ai) ----------------------------------------------------
# The site runs gtag.js in the visitor's browser, not the Measurement Protocol,
# so it needs NO api_secret — the measurement_id ends up in the page source by
# design. It lives in .env anyway so a local `npm run build -w apps/site` stays
# analytics-free unless the variable is exported: a developer reloading pages
# all day should not appear in the property's traffic.
#
# Its own GA4 property + WEB data stream ("Lingogram site"), separate from the
# two extension properties above. Same account. Web-stream ids and MP-stream
# ids are not interchangeable: a hit sent with the wrong one is silently
# dropped, which reads as "no traffic" rather than as a misconfiguration.
SITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# --- dictionary gateway -----------------------------------------------------
# Where the word lookup (/dictionary/lookup) and the saved-word writes go.
#
# Not optional for a release. A build made without it carries apiBaseUrl:"" and
# the lookup is simply off: the worker refuses each request with "lookup not
# configured" and the strip says "Couldn't load". Nothing fails loudly — an
# empty value is a supported state for dev builds, which is why the release
# script refuses it rather than the library doing so.
#
# One variable, two outputs: the URL the worker fetches, and the origin added
# to the manifest's host_permissions (the edge's CORS allow-list has no
# chrome-extension:// origin, so the fetch needs the permission to pass).
#
# The values mirror the frontend's own, so the extension and the site always
# talk to the same gateway:
#   prod    -> english/frontend/.env.lingogram-prod  (VITE_API_URL)
#   preprod -> english/frontend/.env.preprod         (VITE_API_URL)
EXT_API_BASE_URL_PROD=https://api.lingogram.ai
EXT_API_BASE_URL=

# --- dev backend switch ring ------------------------------------------------
# The targets a DEV build can cycle through with the sidebar's `backend:` badge.
# Dev only: build-with-analytics.sh exports these for `dev` and never for a
# release, because each target's origin is written into the manifest's
# externally_connectable — any origin listed there can be handed a signed-in
# user's SSO token, which is how youtube 1.0.15 shipped with preprod listed.
#
# EXT_HOME_TARGET_NAME names the build's OWN target, which is the ring's first
# stop. With the emulator defaults that is the local suite, so the ring reads
#   local -> preprod -> prod -> local
#
# EXT_DEV_TARGETS is ONE JSON array, one row per other target. Required per row:
# projectId, apiKey, frontendBaseUrl — the build FAILS if any is missing rather
# than shipping a ring that quietly lost a stop. Optional: apiBaseUrl and the
# three Firebase hosts (identityToolkitUrl, secureTokenUrl, firestoreUrl).
#
# The hosts are what let ONE dev build reach both the local emulators and a
# cloud project: a row that omits them inherits this build's own, which for a
# local build means localhost — so a CLOUD target must name them.
#
# Values mirror english/frontend/.env.preprod and .env.lingogram-prod.
# Leave both unset and the badge is inert, which is the right outcome for a
# checkout handed no credentials.
EXT_HOME_TARGET_NAME=local
# EXT_DEV_TARGETS=[{"name":"preprod","projectId":"...","apiKey":"...","frontendBaseUrl":"https://...","apiBaseUrl":"https://...","identityToolkitUrl":"https://identitytoolkit.googleapis.com","secureTokenUrl":"https://securetoken.googleapis.com","firestoreUrl":"https://firestore.googleapis.com"}]
