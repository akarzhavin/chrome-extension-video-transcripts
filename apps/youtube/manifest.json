{
  "manifest_version": 3,
  "name": "Learn languages while watching YouTube",
  "version": "0.0.0",
  "description": "Interactive transcripts and dual subtitles to help you understand every word on YouTube.",
  "key": "REPLACE_WITH_BASE64_DER_PUBLIC_KEY",
  "icons": {
    "16": "src/assets/icons/icon16.png",
    "48": "src/assets/icons/icon48.png",
    "128": "src/assets/icons/icon128.png"
  },
  "action": {
    "default_title": "Lingogram",
    "default_popup": "popup.html"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://firestore.googleapis.com/*",
    "http://localhost:9099/*",
    "http://localhost:8080/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*",
      "https://lingogram-app.web.app/*",
      "https://lingogram-app.firebaseapp.com/*"
    ]
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content/page-script.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content/index.js"],
      "css": ["src/assets/styles.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  }
}
