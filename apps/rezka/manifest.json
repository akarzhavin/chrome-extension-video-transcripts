{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_appName__",
  "version": "0.0.0",
  "description": "__MSG_appDesc__",
  "key": "REPLACE_WITH_BASE64_DER_PUBLIC_KEY",
  "icons": {
    "16": "src/assets/icons/icon16.png",
    "48": "src/assets/icons/icon48.png",
    "128": "src/assets/icons/icon128.png"
  },
  "action": {
    "default_title": "Lingogram",
    "default_popup": "popup.html"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.rezka.ag/*",
    "*://*.hdrezka.ag/*",
    "*://*.hdrezka.org/*",
    "*://*.voidboost.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://firestore.googleapis.com/*",
    "http://localhost:9099/*",
    "http://localhost:8080/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*",
      "https://lingogram-app.web.app/*",
      "https://lingogram-app.firebaseapp.com/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.rezka.ag/*",
        "*://*.hdrezka.ag/*",
        "*://*.hdrezka.org/*"
      ],
      "all_frames": true,
      "js": ["src/content/index.js"],
      "css": ["src/assets/styles.css"]
    }
  ],
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/content/network-interceptor.js"],
      "matches": ["*://*.rezka.ag/*", "*://*.hdrezka.ag/*", "*://*.hdrezka.org/*"]
    }
  ]
}
