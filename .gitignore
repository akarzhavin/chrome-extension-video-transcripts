node_modules/
build/
.DS_Store

# Bundled library output — CI rebuilds it before building apps/site, which
# imports the built package (see .github/workflows/site-deploy.yml)
packages/*/dist/

*.log

.claude/
graphify-out/

# Vendored unpacked extensions for screenshot capture (AdBlock Plus, etc.)
apps/*/screenshots/vendor/

# Promo render intermediates / previews (regenerate via
# apps/*/promo/pipelines/<pipeline>/render.mjs). Each pipeline owns one subtree
# under out/ and shots/. apps/*/promo/archive/ is deliberately NOT ignored:
# it holds generations that can no longer be re-rendered from source.
apps/*/promo/shots/
apps/*/promo/out/
apps/*/promo/.build/
apps/*/screenshots/out-live/

# Responsive-audit captures (regenerate via
# apps/site/screenshots/responsive/shoot.mjs against a local build). Image
# output only — the script itself stays tracked.
apps/site/screenshots/responsive/screens/
apps/site/screenshots/responsive/crops/

# Video assets (promo clips, screencasts, source footage)
*.mp4
*.mov
# ...except the landing page's fallback clip, which is a BUILD INPUT, not
# footage: the demo plays it whenever YouTube refuses embedded playback, so CI
# needs it in the checkout or the fallback player 404s.
!apps/site/src/assets/demo-clip.mp4

# Backup files
*.bak

# Competitor extensions downloaded for research (Linglass, Lingosive) — not ours
competitor-extensions/

# Root docs: strategy / keyword-research / listing working notes (leading slash
# so app docs like apps/rezka/docs/ stay tracked)
/docs/

# Local-only dev server that stitches the landing + SPA on one origin (mirrors
# the prod firebase.json rewrite). Not shipped — CI builds and deploys the site.
apps/site/dev-serve.mjs

# Firebase deploy artifacts must never exist here. This repo builds the landing
# page; it does NOT deploy it. The authoritative hosting config lives in the
# english repo (frontend/firebase.json) and ships via frontend/.gitlab-ci.yml,
# which copies apps/site/build/ to dist/ and the SPA to dist/app/ — one site,
# one deploy. A hand-written firebase.json here has neither the SPA nor the
# /extension-auth -> /app/extension-auth redirect table, and `firebase deploy`
# replaces a site wholesale: deploying from this directory takes down the whole
# web app. This happened on 2026-08-04. Deploy from the english repo instead.
firebase.json
.firebase/

# Jest coverage output. Regenerated on every `npm test -- --coverage`, which is
# now the normal invocation: jest.config.js enforces a coverage threshold on
# the analytics modules, so the report is a build artifact, not a source file.
coverage/

# GA4 Measurement Protocol credentials. The api_secret is write-only (it can
# send events to a property, never read from it), so a leak is data poisoning
# rather than exfiltration — but a poisoned funnel is exactly the failure this
# whole iteration exists to avoid, and rotating means re-issuing in the GA4
# admin. Builds read these from the environment; see docs/analytics-setup.md.
.env
.env.*
!.env.example

# Extension release archives. Everything up to v1.0.14 is committed here and
# stays that way — rewriting history to evict 4.3MB of zips would cost every
# clone a re-fetch for no gain. From v1.0.15 on, release artifacts live in
# GitHub Releases instead, attached to a per-app tag (youtube-v1.0.15,
# rezka-v1.0.15), so the repo stops growing by ~400KB per release.
#
# The already-tracked zips are unaffected: git keeps following files that are
# already in the index, ignore rules only govern untracked ones.
releases/*.zip

# One-off live-debugging probes against preprod, driven over CDP (port 9333).
# Each was written to answer a single question — which apiBase the login page
# resolves, who still calls the retired gateway, what fails during sign-in —
# against a browser session a human was holding open at that moment. They are
# throwaway instruments, not tooling: none runs without that live session, and
# the next question wants a new probe rather than a rerun of an old one. The
# reusable CDP helpers live in scripts/lib/ and stay tracked.
scripts/lingogram-*.mjs
