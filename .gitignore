node_modules/
build/
.DS_Store

# Bundled library output — CI rebuilds it before building apps/site, which
# imports the built package (see .github/workflows/site-deploy.yml)
packages/*/dist/

*.log

.claude/
graphify-out/

# Vendored unpacked extensions for screenshot capture (AdBlock Plus, etc.)
apps/*/screenshots/vendor/

# Promo render intermediates / previews (regenerate via apps/*/promo/render*.mjs)
apps/*/promo/shots/
apps/*/promo/out/
apps/*/screenshots/out-live/

# Responsive-audit captures (regenerate via
# apps/site/screenshots/responsive/shoot.mjs against a local build). Image
# output only — the script itself stays tracked.
apps/site/screenshots/responsive/screens/
apps/site/screenshots/responsive/crops/

# Video assets (promo clips, screencasts, source footage)
*.mp4
*.mov
# ...except the landing page's fallback clip, which is a BUILD INPUT, not
# footage: the demo plays it whenever YouTube refuses embedded playback, so CI
# needs it in the checkout or the fallback player 404s.
!apps/site/src/assets/demo-clip.mp4

# Backup files
*.bak

# Competitor extensions downloaded for research (Linglass, Lingosive) — not ours
competitor-extensions/

# Root docs: strategy / keyword-research / listing working notes (leading slash
# so app docs like apps/rezka/docs/ stay tracked)
/docs/

# Local-only dev server that stitches the landing + SPA on one origin (mirrors
# the prod firebase.json rewrite). Not shipped — CI builds and deploys the site.
apps/site/dev-serve.mjs

# Local secrets (GA4 measurement/API keys) and coverage output — never commit
.env
.env.local
coverage/
