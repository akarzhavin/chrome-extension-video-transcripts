{
  "manifest_version": 3,
  "name": "VTT Sidebar Reader",
  "version": "1.0",
  "description": "Reads and displays VTT subtitles in a sidebar with video synchronization.",
  "permissions": [
    "webRequest", 
    "storage"
  ],
  "host_permissions": [
    "*://*.rezka.ag/*",
    "*://*.hdrezka.ag/*",
    "*://*.hdrezka.org/*",
    "*://*/*.vtt*" 
  ],
  "content_scripts": [
    {
      "matches": ["*://*.rezka.ag/*", "*://*.hdrezka.ag/*", "*://*.hdrezka.org/*", "<all_urls>"],
      "all_frames": true, 
      "js": [
        "src/content/index.js"
      ],
      "css": ["src/assets/styles.css"]
    }
  ],
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  }
}
